{
  "name": "satteri-custom-header-id",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@11.25.0",
  "description": "A Sätteri plugin for custom heading IDs ({#custom-id})",
  "author": "ocavue <ocavue@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/satteri-custom-header-id#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/satteri-custom-header-id.git"
  },
  "bugs": "https://github.com/ocavue/satteri-custom-header-id/issues",
  "keywords": [
    "satteri",
    "markdown",
    "mdx",
    "heading",
    "header",
    "id",
    "anchor",
    "hast",
    "astro"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxfmt && pnpm run lint:knip",
    "lint:oxfmt": "oxfmt --check",
    "lint:eslint": "eslint",
    "lint:knip": "knip",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:eslint",
    "fix:oxfmt": "oxfmt",
    "fix:eslint": "eslint --fix",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "satteri": "^0.9.0 || ^0.10.0"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.16.1",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "satteri": "^0.10.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
